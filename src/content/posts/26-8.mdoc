-- ==========================================
-- Hammerspoon 极客信息采集系统 (v2.2 - 最终兼容版)
-- ==========================================


-- 快捷键修改为：Control + Option + T
hs.hotkey.bind({"ctrl", "alt"}, "V", function()
    -- 获取当前日期时间
    local timeStr = os.date("%Y-%m-%d %H:%M:%S")

    -- 1. 放入剪贴板 (Maccy 会自动捕获这个变动)
    hs.pasteboard.setContents(timeStr)

    -- 2. 直接在当前光标位置模拟打字输入
    hs.eventtap.keyStrokes(timeStr)
end)

-- 1. 配置信息
local save_folder = os.getenv("HOME") .. "/Library/Mobile Documents/com~apple~CloudDocs/Clippings/"
local min_length = 5
local blacklisted_apps = {
    ["1Password"] = true, ["Keychain Access"] = true, ["钥匙串访问"] = true, ["Bank"] = true, ["银行"] = true,
}

-- 2. 辅助函数：通过具体的 App 名称获取浏览器数据
local function getBrowserData()
    local app = hs.application.frontmostApplication()
    if not app then return nil, nil end
    local appName = app:name()

    local script = ""

